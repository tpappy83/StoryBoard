{
  "entities": {
    "User": {
      "title": "User",
      "description": "User profile document",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "email": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["uid", "email"]
    },
    "NarrativeProject": {
      "title": "NarrativeProject",
      "description": "Narrative workspace project",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "title": { "type": "string", "maxLength": 200 },
        "genre": { "type": "string", "maxLength": 100 },
        "continuityScore": { "type": "number" },
        "updatedAt": { "type": "string" }
      },
      "required": ["id", "userId", "title"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "User",
      "description": "User profile"
    },
    "/projects/{projectId}": {
      "schema": "NarrativeProject",
      "description": "User narrative projects"
    }
  }
}
