{
  "entities": {
    "project": {
      "title": "Project",
      "description": "A user's narrative project",
      "type": "object",
      "properties": {
        "project": { "type": "object", "description": "Project metadata" },
        "characters": { "type": "array", "description": "List of characters" },
        "relationships": { "type": "array", "description": "List of relationships" },
        "plotThreads": { "type": "array", "description": "List of plot threads" },
        "convergenceEvents": { "type": "array", "description": "List of convergence events" },
        "scenes": { "type": "array", "description": "List of scenes" },
        "timelineEvents": { "type": "array", "description": "List of timeline events" },
        "canonFacts": { "type": "array", "description": "List of canon facts" },
        "violations": { "type": "array", "description": "List of continuity violations" },
        "structureMilestones": { "type": "array", "description": "List of structure milestones" },
        "setups": { "type": "array", "description": "List of setups" },
        "payoffs": { "type": "array", "description": "List of payoffs" }
      }
    }
  },
  "firestore": {
    "/projects/{userId}": {
      "schema": { "$ref": "#/entities/project" },
      "description": "User's projects"
    }
  }
}
